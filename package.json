{
  "name": "htmlpoint",
  "version": "0.1.0",
  "description": "Offline Windows portable HTML report editor with a PowerPoint-style shell.",
  "main": "dist-electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e:renderer": "concurrently -k --success first \"vite preview --host 127.0.0.1 --strictPort --port 4173\" \"wait-on tcp:4173 && node tests/e2e/renderer-performance.cjs\"",
    "verify:release": "npm run package && npm run test:unit && npm run test:e2e:renderer",
    "package": "npm run build && electron-builder --win portable",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.lges.htmlpoint",
    "productName": "HTMLpoint",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "HTML_reference",
        "to": "HTML_reference",
        "filter": [
          "*.html"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "HTMLpoint-${version}-portable.exe"
    }
  }
}
